# Backup files from deploy scripts
*.bak.*

# Build outputs
dashboard/dist/
dashboard/.vite/

# Dependencies
node_modules/
**/node_modules/

# Local dev
.env
.env.local
.env.*.local

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Wrangler / Cloudflare local state
.wrangler/
**/.wrangler/

# Archive/zip artifacts
*.zip

node_modules/

# Session-specific debugging scripts (not for repo)
patch_worker.py
scripts/check-cron-deploy-*.mjs
.progress-entry.tmp
.commit-msg.tmp

# Phase F (2026-05-22) and onward
# Per-user Claude Code session state, no value in shared repo
.claude/
# Local diff dumps from inspection
phase-*-diff.txt
phase-*-bugfix-diff.txt
# Long commit message temp files (we use [System.IO.File]::WriteAllText for these)
COMMIT_MSG_*.txt
# Regression test artifacts (session-specific, regenerated per run)
phase_f_*.json
run_phase_f_regression_v*.ps1

# Local env and Cloudflare account state, untracked 2026-08-12 (chore(security)).
# These hold per-environment config and must never live in the repo. The files
# stay on disk; the deploy chain reads them from disk, not from git. Template of
# the key names lives in dashboard/.env.example.
dashboard/.env
dashboard/.env.production
dashboard/.env.staging
.wrangler/cache/
# sales-bot wrangler oauth cache. node_modules is already ignored above; this is
# explicit intent and stops the recurring tracked-file noise once untracked.
**/node_modules/.cache/wrangler/
